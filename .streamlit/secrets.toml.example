# 复制本文件为 .streamlit/secrets.toml 并填入真实值（secrets.toml 已被 .gitignore 忽略，不会提交）
# 在 Streamlit Cloud 部署时，直接到 Settings → Secrets 粘贴同样内容即可。

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key"

# ↓ 以下两项用于「邀请码授权注册」与「管理员面板」，缺失时相关功能降级不可用
# service_role 密钥绕过 RLS，仅服务端使用，严禁写入前端 JS 或暴露给任何人
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-secret-key"
# 管理员面板解锁密码（登录页底部「管理员入口」展开后输入）
ADMIN_PASSWORD = "change-me-admin-password"

# ===== 气候态模块（地基层）=====
# 后端选择：localfile（本地文件优先）| openmeteo（近似兜底）| era5noaa / noaa（M3 接入，未启用时自动降级 openmeteo）
CLIMATE_BACKEND = "localfile"
# 方案1：本地气候态文件
CLIMATE_LOCAL_CSV = ""          # 本地 CSV 文件路径（绝对路径或仓库内相对路径）；留空则依赖网页上传
CLIMATE_LOCAL_NC = ""           # 本地 NetCDF 路径（M2 启用，需 xarray+h5netcdf）
CLIMATE_LOCAL_PREFER = "csv"    # csv | nc
CLIMATE_MAX_RADIUS = 50         # 最近站匹配半径（km），超出则提示无匹配
CLIMATE_ALLOW_OPENMETEO_FALLBACK = true   # 无本地文件且无 API 时是否允许 Open-Meteo 近似兜底
# 方案2：ERA5 / Copernicus CDS（M3 接入）
CDS_URL = "https://cds.climate.copernicus.eu/api/v2"
CDS_KEY = "你的UID:你的APIKEY"
ERA5_BASE_PERIOD = "1991-2020"
ERA5_AREA_PAD = 0.5             # 单点请求外扩半径（°）
# 方案2 备选：NOAA（M3 接入）
NOAA_TOKEN = ""

# ===== AI 预警叙事 (C 方案) =====
# 使用 DeepSeek（OpenAI 兼容协议）。缺失时 AI 解读块自动降级为结构化摘要。
LLM_API_KEY = ""                          # DeepSeek API Key（https://platform.deepseek.com）
LLM_BASE_URL = "https://api.deepseek.com"
LLM_MODEL = "deepseek-chat"
