# 复制本文件为 .streamlit/secrets.toml 并填入真实值（secrets.toml 已被 .gitignore 忽略，不会提交）
# 在 Streamlit Cloud 部署时，直接到 Settings → Secrets 粘贴同样内容即可。

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key"

# ↓ 以下两项用于「邀请码授权注册」与「管理员面板」，缺失时相关功能降级不可用
# service_role 密钥绕过 RLS，仅服务端使用，严禁写入前端 JS 或暴露给任何人
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-secret-key"
# 管理员面板解锁密码（登录页底部「管理员入口」展开后输入）
ADMIN_PASSWORD = "change-me-admin-password"

# ===== 文本模型（OpenAI 兼容协议）=====
# 说明：自 2.3.7 起平台不再有文本模型的生产调用者（原「AI 预警叙事」已由
# 「AI 读图解析」取代），这三项作为保留配置存在，缺失不影响任何功能。
LLM_API_KEY = ""                          # 例：DeepSeek API Key（https://platform.deepseek.com）
LLM_BASE_URL = "https://api.deepseek.com"
LLM_MODEL = "deepseek-chat"

# ===== AI 读图解析（多模态）=====
# LLM_VISION_MODEL 必须显式配置，且必须是具备图像输入能力的模型。
# 它**不会回落到 LLM_MODEL**：默认的 deepseek-chat 没有视觉能力，回落只会造成
# 「配置了却一直失败」的隐性故障。未配置时读图页给出配置指引且不显示生成按钮。
LLM_VISION_MODEL = ""                     # 例：qwen-vl-max / glm-4v / gpt-4o
LLM_VISION_BASE_URL = ""                  # 留空则回落到 LLM_BASE_URL，再回落 https://api.deepseek.com
LLM_VISION_API_KEY = ""                   # 留空则回落到 LLM_API_KEY
# 输出预算，省略即用默认 16000。推理型模型的思考过程也从这里扣额度，实测某模型
# 双图用掉 10437 个 reasoning tokens，而六段正文只需约 1100——预算给小了会表现为
# 「返回空正文」（finish_reason=length）。合法范围 256–32000，非法值回落默认。
# 注意：预算是上限而非实际扣费，但推理型模型的实际用量可能上万 token，成本与耗时
# 明显更高；若只求快与省，换非推理型多模态模型（qwen-vl-max / glm-4v / gpt-4o）。
LLM_VISION_MAX_TOKENS = ""                # 例：24000（留空用默认 16000）
