# 复制本文件为 .streamlit/secrets.toml 并填入真实值（secrets.toml 已被 .gitignore 忽略，不会提交）
# 在 Streamlit Cloud 部署时，直接到 Settings → Secrets 粘贴同样内容即可。

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key"

# ↓ 以下两项用于「邀请码授权注册」与「管理员面板」，缺失时相关功能降级不可用
# service_role 密钥绕过 RLS，仅服务端使用，严禁写入前端 JS 或暴露给任何人
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-secret-key"
# 管理员面板解锁密码（登录页底部「管理员入口」展开后输入）
ADMIN_PASSWORD = "change-me-admin-password"

# ===== 文本模型（OpenAI 兼容协议）=====
# 说明：本版 2.4.0 不再有文本模型的生产调用者（原「AI 预警叙事」已由
# 「AI 读图解析」取代），这三项作为保留配置存在，缺失不影响任何功能。
LLM_API_KEY = ""                          # 例：DeepSeek API Key（https://platform.deepseek.com）
LLM_BASE_URL = "https://api.deepseek.com"
LLM_MODEL = "deepseek-chat"

# ===== AI 读图解析（服务端配置；云端填写应用的 Secrets）=====
# 默认 Qwen3.8 Flash，可选 GPT-6.1 Terra xhigh 和 Sol high 专业增强。
# 两家凭据独立。本机已保存的 BASELINE_VISION_API_KEY 可直接用于 Qwen。
QWEN_VISION_API_KEY = ""
QWEN_VISION_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# 支持进程环境变量、Streamlit Secrets，以及本机受限权限的 .env.local。
OPENAI_API_KEY = ""
OPENAI_BASE_URL = "https://api.openai.com/v1"
# 三种模型生成上限均为32768，实际输出还受服务端本次预留预算约束。
# OpenAI后台结果按同一response ID取回；Qwen流式接收。正文800至2000字。
# 兼容原Qwen部署配置；仅当模型名以qwen开头时用于Qwen，不回落给OpenAI。
# 视觉模型不会回落到 LLM_MODEL；保留的文本模型配置没有图像处理职责。
LLM_VISION_MODEL = "qwen3.8-flash"
LLM_VISION_API_KEY = ""
LLM_VISION_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
